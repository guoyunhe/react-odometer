{
  "name": "@guoyunhe/react-odometer",
  "version": "0.0.0",
  "description": "A React component for smooth, rolling number animations.",
  "keywords": [
    "animation",
    "counter",
    "number",
    "odometer",
    "react"
  ],
  "homepage": "https://github.com/guoyunhe/react-odometer#readme",
  "bugs": {
    "url": "https://github.com/guoyunhe/react-odometer/issues"
  },
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/guoyunhe/react-odometer.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "vite --config playground/vite.config.ts",
    "dev:lib": "tsdown --watch",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "playground": "vite --config playground/vite.config.ts",
    "playground:build": "vite build --config playground/vite.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@guoyunhe/oxfmt-config": "^1.1.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "oxfmt": "^0.74.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "peerDependencies": {
    "react": ">=18"
  }
}
