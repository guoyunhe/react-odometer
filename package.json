{
  "name": "@guoyunhe/react-odometer",
  "version": "0.1.3",
  "description": "A React component for smooth, rolling number animations.",
  "keywords": [
    "animation",
    "counter",
    "number",
    "odometer",
    "react"
  ],
  "homepage": "https://guoyunhe.github.io/react-odometer/",
  "bugs": {
    "url": "https://github.com/guoyunhe/react-odometer/issues"
  },
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/guoyunhe/react-odometer.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "vited dev",
    "dev:lib": "tsdown --watch",
    "docs": "vited dev",
    "docs:build": "vited build",
    "docs:dev": "vited dev",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "prepare": "husky",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@guoyunhe/oxfmt-config": "^1.1.0",
    "@mantine/core": "^9.8.0",
    "@mantine/form": "^9.8.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vited/cli": "^0.1.4",
    "@vited/core": "^0.4.5",
    "@vited/theme-mantine": "^0.5.3",
    "@vitejs/plugin-react": "^6.3.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.74.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,mts,cts,jsx,tsx,vue,json,jsonc,css,scss,less,htm,html,md,mdx,yaml,yml}": "oxfmt --write"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.14.0",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "version": "^20.19.0 || >=22.12.0",
      "onFail": "error"
    }
  },
  "packageManager": "pnpm@12.14.0"
}
